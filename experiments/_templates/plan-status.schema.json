{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan-status.schema.json",
  "title": "Experiment plan status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "plan_id",
    "sequence",
    "baseline_path",
    "status",
    "approval",
    "updated_at",
    "current_step",
    "last_amendment",
    "depends_on",
    "gate",
    "artifacts",
    "artifact_budget"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "pattern": "^[0-9]{8}_[0-9]{6}$"},
    "plan_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "baseline_path": {"type": "string", "pattern": "^plans/[0-9]{2}-.+\\.md$"},
    "status": {
      "enum": [
        "draft",
        "approved",
        "in_progress",
        "blocked",
        "completed",
        "cancelled",
        "superseded"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "authority", "approved_at"],
      "properties": {
        "state": {"enum": ["pending", "approved", "rejected"]},
        "authority": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "updated_at": {"type": "string", "format": "date-time"},
    "current_step": {"type": ["string", "null"]},
    "last_amendment": {
      "type": ["string", "null"],
      "pattern": "^P[0-9]{2}-A[0-9]{3}$"
    },
    "depends_on": {
      "type": "array",
      "items": {"type": "string", "pattern": "^P[0-9]{2}$"},
      "uniqueItems": true
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "summary"],
      "properties": {
        "state": {"enum": ["closed", "open", "passed", "not_applicable"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "baseline_plan",
              "status_file",
              "amendment_log",
              "runbook",
              "final_report",
              "handoff",
              "machine_output"
            ]
          }
        }
      }
    },
    "artifact_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limits", "exceptions"],
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_plan",
            "status_file",
            "amendment_log",
            "runbook",
            "final_report",
            "handoff",
            "machine_output"
          ],
          "properties": {
            "baseline_plan": {"type": "integer", "minimum": 0},
            "status_file": {"type": "integer", "minimum": 0},
            "amendment_log": {"type": "integer", "minimum": 0},
            "runbook": {"type": "integer", "minimum": 0},
            "final_report": {"type": "integer", "minimum": 0},
            "handoff": {"type": "integer", "minimum": 0},
            "machine_output": {"type": "integer", "minimum": 0}
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reason"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}

