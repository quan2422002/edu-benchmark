                    <mxGeometry x="70" y="660" width="760" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="judge-package" value="&lt;b&gt;Evaluation package&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Vietnamese context in System prompt&lt;/b&gt;&lt;br&gt;Câu hỏi nguồn: &quot;Các cột của trang tính được đặt tên như thế nào?&quot;&lt;br&gt;Đáp án chuyên môn: &quot;A, B, C... từ trái sang phải.&quot;&lt;br&gt;Lời học sinh: &quot;Vậy còn các chữ cái A, B, C ở phía trên là gì hả thầy?&quot;&lt;div&gt;&lt;font color=&quot;#304b63&quot;&gt;Lịch sử hội thoại:....&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Applicable rubrics: 4 + 3k&lt;/b&gt;&lt;br&gt;Four common criteria + three criteria for each required principle&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FA;strokeColor=#63819A;strokeWidth=1.9;fontColor=#304B63;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;shadow=1;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="930" y="125" width="500" height="230" as="geometry"/>
